# Razorpay credentials (use your own test keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Gemini cognitive layer (Google AI Studio key). GEMINI_MODEL is overridable to
# track whichever Flash model your key can access.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# When true, channel adapters make real outbound calls (WhatsApp/voice/Razorpay).
# Keep false for the batch harness so it never spams real customers.
LIVE_MODE=false

# Twilio WhatsApp (live channel). TWILIO_WHATSAPP_FROM defaults to the sandbox.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Vapi voice. Leave empty to keep the voice adapter simulated.
VAPI_API_KEY=

# Comma-separated CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Fernet key for encrypting PII at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=lQph_-bYdMAZufFM4_P4_MZPe0nhMlECaKFgpegpODc=
